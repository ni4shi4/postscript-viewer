{
  "name": "postscript-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "fetch:wasm": "node scripts/fetch-gs-wasm.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && npm run check:deps",
    "check:deps": "node scripts/check-deps.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:small": "vitest run --project small",
    "test:large": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs}": "oxlint",
    "*.{ts,mjs,html,css}": "oxfmt --check",
    "!(package-lock).json": "oxfmt --check"
  },
  "dependencies": {
    "ghostscript-wasm-esm": "1.0.1",
    "pako": "3.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pako": "2.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
