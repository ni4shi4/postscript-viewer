{
  "name": "postscript-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "fetch:wasm": "node scripts/fetch-gs-wasm.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --config vite.config.e2e-preview.ts",
    "preview:e2e-servers": "node scripts/start-e2e-preview-servers.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && npm run check:deps && npm run check:final-newline",
    "check:deps": "node scripts/check-deps.mjs",
    "check:final-newline": "editorconfig-checker",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:small": "vitest run --project small",
    "test:medium": "vitest run --project medium",
    "test:large": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "oxlint",
    "*.{ts,tsx,mjs,html,css}": "oxfmt --check",
    "!(package-lock).json": "oxfmt --check",
    "*": "editorconfig-checker"
  },
  "dependencies": {
    "ghostscript-wasm-esm": "1.0.1",
    "pako": "3.0.3",
    "pdfjs-dist": "6.5.438",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pako": "2.0.4",
    "editorconfig-checker": "7.0.0",
    "fake-indexeddb": "6.2.8",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.1"
  }
}
