{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**", "PLAN.md"],
  "overrides": [
    {
      "files": [
        "scripts/**/*.mjs",
        "e2e/**/*.mjs",
        "vite.config.ts",
        "vite.config.e2e-preview.ts",
        "vite/**/*.ts",
        "playwright.config.ts",
        "e2e/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/core/**/*.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(?:^|/)adapters/",
                "message": "core must not import adapters"
              },
              {
                "regex": "(?:^|/)generated/",
                "message": "core must not import generated Ghostscript glue"
              }
            ]
          }
        ],
        "no-restricted-globals": ["error", "window", "document", "Worker"]
      }
    },
    {
      "files": ["src/adapters/driven/postscript-converter/convert.worker.ts"],
      "env": {
        "worker": true
      },
      "rules": {
        // Dedicated Worker postMessage の第2引数は transfer list。Window の targetOrigin ではないため誤検知。
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "excludeFiles": [
        "src/core/**/*.ts",
        "src/adapters/driven/postscript-converter/convert.worker.ts"
      ],
      "env": {
        "browser": true
      }
    }
  ]
}
