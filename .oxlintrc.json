{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**", "PLAN.md"],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "vite.config.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["src/worker/**/*.ts"],
      "env": {
        "worker": true
      },
      "rules": {
        // Dedicated Worker postMessage の第2引数は transfer list。Window の targetOrigin ではないため誤検知。
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "excludeFiles": ["src/worker/**/*.ts"],
      "env": {
        "browser": true
      }
    }
  ]
}
